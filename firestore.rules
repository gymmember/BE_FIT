rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == '0YvEuJTQlUTq60Bxehxg5z4F1gC3';
    }

    match /test/connection {
      allow read: if true;
    }

    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && (isAdmin() || request.auth.uid == userId);
      
      match /chats/{messageId} {
        allow read, write: if request.auth != null && (isAdmin() || request.auth.uid == userId);
      }
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /passes/{passId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
    }
  }
}
